{
  "name": "readr",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run validate:mock-book",
    "seed:supabase": "tsx scripts/seed/supabaseSeed.ts",
    "supabase:check": "tsx scripts/supabase/checkSetup.ts",
    "ingest:gatsby": "tsx scripts/ingest/runGatsby.ts",
    "validate:mock-book": "tsx scripts/validate/mockBookSchema.ts"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "~53.0.0",
    "expo-asset": "~11.1.7",
    "expo-auth-session": "~6.2.1",
    "expo-av": "~15.1.7",
    "expo-constants": "~17.1.8",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-linking": "~7.1.7",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "^25.9.1",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.4.1",
    "jszip": "^3.10.1",
    "node-html-parser": "^7.1.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.8"
  }
}
