EXPO_PUBLIC_SUPABASE_URL=

# App client key — use Publishable key (sb_publishable_...) from Dashboard → Settings → API Keys.
# EXPO_PUBLIC_SUPABASE_ANON_KEY is the legacy env name; publishable key goes here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_ASK_AI_FALLBACK=true

# Seed / admin scripts only (never ship in the app bundle).
# Use Secret key (sb_secret_...) from Dashboard → Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Content pipeline (Phase 1):
#   npm run ingest:gatsby     → src/mocks/mockBook.json (from SE GitHub source)
#   Apply supabase/migrations including 004_text_storage.sql
#   npm run seed:supabase     → uploads text/ + sync/ + DB rows

# Copy this file to `.env` and fill in Supabase values.
# Auth: see supabase/AUTH_SETUP.md (OTP template + optional custom SMTP).
# API keys: see supabase/AUTH_SETUP.md#api-keys-after-a-leak
# Without Supabase, use "Continue without signing in" on the auth screen (__DEV__ only).
